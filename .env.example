APP_NAME="Namikulo Course"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
ASSET_URL=https://otika.namikulo.com/assets

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=namikulo_course
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Switch to r2 only after storage:migrate-r2 --copy and --verify succeed.
MEDIA_STORAGE=local
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
VIDEO_DISK=video_private
VIDEO_SOURCE_MAX_SIZE_MB=500
VIDEO_SOURCE_MAX_DURATION_SECONDS=1800
VIDEO_UPLOAD_MAX_SIZE_MB=750
VIDEO_SEGMENT_MAX_SIZE_MB=25
VIDEO_MAX_SEGMENTS=2000
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1080
VIDEO_PROCESS_TIMEOUT_MINUTES=60
VIDEO_SESSION_TTL_MINUTES=10
VIDEO_HEARTBEAT_SECONDS=60
VIDEO_ACCEL_REDIRECT=false
OPERATIONS_PLAYBACK_RETENTION_DAYS=30
OPERATIONS_UPLOAD_STALE_HOURS=24

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=5
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
# R2: region=auto, bucket=namikulo-course, endpoint copied from R2 dashboard.
AWS_ENDPOINT=

SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

COURSE_ACCESS_MONTHS=6
COURSE_PENDING_ORDER_TTL_HOURS=24
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENABLED_CHANNELS=bca,bni,bri,permata,cimb,qris,gopay,shopeepay
INVOICE_SELLER_NAME="${APP_NAME}"
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_EMAIL="${MAIL_FROM_ADDRESS}"
INVOICE_SELLER_TAX_ID=
OPERATIONS_CRON_TOKEN=
OPERATIONS_BATCH_SIZE=20
OPERATIONS_MAX_SECONDS=10
NOTIFICATION_DIGEST_BATCH_SIZE=3
